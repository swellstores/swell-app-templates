# Local development variables loaded by Wrangler and Cloudflare's Vite plugin.
# This file is excluded from deployment by `swell app push`.
# It is committed to git: keep secrets out of it.
#
# Swell signs the request context it sends to this app, and the app verifies
# the signature. Set this to "false" to skip verification, for example when
# developing against a local Swell instance. Deployed apps always verify.
SWELL_VERIFY_HEADERS=true
