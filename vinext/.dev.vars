# Local development variables loaded by Wrangler and Cloudflare's Vite plugin.
# This file is excluded from deployment by `swell app push` and ignored by git.
#
# Swell signs the request context it sends to this app, and the app verifies
# the signature. Set this to "false" to skip verification in local
# development. Deployed apps always verify.
SWELL_VERIFY_HEADERS=true
