{
  "name": "frontend",
  "version": "0.1.4",
  "private": true,
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vinext": "1.0.0",
    "react-server-dom-webpack": "19.3.0",
    "@vinext/cloudflare": "1.0.0",
    "@swell/apps-sdk": "2.0.0-alpha.1",
    "swell-js": "5.9.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.35",
    "@cloudflare/vite-plugin": "1.62.2",
    "wrangler": "4.144.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "preview": "npm run build && npm run start --",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./worker-configuration.d.ts",
    "typecheck": "vinext typegen && tsc --noEmit --incremental false",
    "check": "npm run typecheck && npm run build",
    "prepare:managed": "node scripts/prepare-managed.mjs"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
